# Supabase — project URL + keys (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API — server-side answer grading
ANTHROPIC_API_KEY=
# Optional: override the grading model (defaults to claude-haiku-4-5-20251001,
# which is well-suited and cost-effective for this simple grading task).
GRADING_MODEL=

# Protects Vercel Cron endpoints (weekly rollups / recalibration)
CRON_SECRET=

# DEV ONLY — enables destructive test scripts (npm run test:reset / test:children).
# Set this to 1 in your local .env.local. NEVER set it in a production environment.
ALLOW_TEST_RESET=
# Optional extra guard: if set, the reset script refuses to run against this URL.
PRODUCTION_SUPABASE_URL=
